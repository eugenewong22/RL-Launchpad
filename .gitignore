.venv/
__pycache__/
*.pyc
.pytest_cache/
# NOT ignoring results/*.mp4: the demo clips are deliverables (R4 requires
# video from the reported checkpoint) and docs/writeup.md cites one by path.
# All four total ~450 KB. Scratch renders go to a name we do ignore:
results/scratch_*.mp4
# SLURM job stdout from the cluster runs; the reported evidence is the
# committed progress.csv / config.yaml under results/, not these.
logs/
# Stabilizer-ablation weights. The ablation's evidence is the learning curve
# in progress.csv, which IS committed; no reported number depends on these
# checkpoints, and 5 arms x 3.6 MB of churn is not worth carrying.
results/ablate_*/checkpoint_*.pt
